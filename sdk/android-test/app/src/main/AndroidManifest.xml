<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Выдаётся при установке, диалога нет. Нужна, чтобы узнавать о записи экрана (Android 15+). -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />

    <!-- Без этого блока Android 11+ скрывает от приложения чужие программы и их службы. -->
    <queries>
        <package android:name="com.anydesk.anydeskandroid" />
        <package android:name="com.carriez.flutter_hbb" />
        <package android:name="com.teamviewer.quicksupport.market" />
        <package android:name="com.teamviewer.host.market" />
        <package android:name="com.sand.airdroid" />
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Проверка сигналов"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
